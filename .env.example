# ── Sorteo Studio · variables de entorno ────────────────────────────────────
# Copia este archivo a .env para desarrollo local. En Dokploy se configuran
# en la pestaña Environment de la aplicación (nunca en el repo).

# Puerto HTTP del servidor
PORT=3000

# Carpeta de datos persistentes: app.db + uploads/
# En Docker/Dokploy debe apuntar al volumen montado.
DATA_DIR=./.data

# Secreto de sesión (mínimo 32 caracteres aleatorios).
# Si se omite, el servidor genera uno y lo guarda en DATA_DIR/secret.
SESSION_SECRET=cambia-esto-por-32-caracteres-aleatorios

# Administrador inicial (solo se usa si no existe ningún admin en la base).
# Contraseña de mínimo 10 caracteres. Cámbiala después del primer acceso.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CambiaEstaClave2026

# Origin público para validación CSRF (opcional; se infiere de X-Forwarded-*)
# APP_ORIGIN=https://sorteo-studio.example.com

# Entorno
NODE_ENV=development
